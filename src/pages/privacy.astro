---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../lib/site';

const lastUpdated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Privacy Policy"
  description="AgentBluebook's privacy policy: what data this site does and doesn't collect."
>
  <section class="page-hero">
    <div class="container">
      <span class="tag tag-gold">Legal</span>
      <h1>Privacy Policy</h1>
      <p>Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="section">
    <div class="content-width page-body">
      <h2>What we collect</h2>
      <p>AgentBluebook is a static website. We do not require accounts, and we do not collect personal information directly. We do not use advertising trackers.</p>

      <h2>Hosting</h2>
      <p>This site is served by Cloudflare, which processes standard request logs (IP address, user agent, pages requested) to deliver and secure the site. See <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">Cloudflare's privacy policy</a> for how that data is handled.</p>

      <h2>Affiliate links</h2>
      <p>Some outbound links are affiliate links. When you click one, the destination site and its affiliate network may set cookies to attribute your visit. Those cookies are governed by the destination's privacy policy, not ours. Our <a href="/affiliate-disclosure">affiliate disclosure</a> explains the relationship.</p>

      <h2>Email</h2>
      <p>If you email us, we keep the correspondence to respond to it. We don't add you to any mailing list or share your address.</p>

      <h2>Changes</h2>
      <p>If our data practices change (for example, if we add analytics or a newsletter), this policy will be updated before those changes take effect.</p>

      <h2>Contact</h2>
      <p>Questions about this policy: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    </div>
  </section>
</Base>

<style>
.page-hero { background: var(--navy); padding: 64px 0; }
.page-hero .tag { margin-bottom: 16px; display: inline-block; }
.page-hero h1 { color: var(--white); margin-bottom: 16px; }
.page-hero p { color: rgba(255,255,255,0.75); font-size: 1rem; margin: 0; }
.page-body h2 { margin: 40px 0 16px; }
.page-body p { color: var(--gray-600); line-height: 1.7; margin-bottom: 1.25rem; }
.page-body a { color: var(--navy); text-decoration: underline; }
</style>

---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES, getPublishedArticles, articlesInCategory } from '../lib/site';

const articles = await getPublishedArticles();
const featured = articles.slice(0, 3);
const reviewCount = articles.length;

// Real hero cards: top-scored published reviews, best first.
const scored = articles
  .filter(a => typeof a.data.score === 'number')
  .sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0));
const heroCards = scored.slice(0, 2).map((a, i) => ({
  label: i === 0 ? "TOP RATED" : "BEST VALUE",
  title: a.data.title.split(/ Review| 2026|:/)[0],
  score: a.data.score,
  meta: a.data.bestFor ? `Best for: ${a.data.bestFor}` : a.data.verdict,
  href: `/${a.slug}`,
}));

const categories = CATEGORIES.map(cat => {
  const count = articlesInCategory(articles, cat.slug).length;
  return {
    label: cat.navLabel,
    href: `/category/${cat.slug}`,
    icon: cat.icon,
    count: count > 0 ? `${count} ${count === 1 ? 'review' : 'reviews'}` : 'Reviews coming soon',
    description: cat.description,
  };
});

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AgentBluebook",
  "url": "https://agentbluebook.com",
  "description": "Unbiased reviews and comparisons of real estate agent tools, CRM software, lead generation platforms, and marketing technology.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://agentbluebook.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<Base
  title="Honest Reviews of Real Estate Agent Tools"
  description="AgentBluebook — the unbiased reference guide for real estate agent tools. Honest CRM reviews, lead gen comparisons, and software ratings from people who actually use them."
  schema={homeSchema}
>

<!-- ── HERO ── -->
<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="tag tag-gold">Unbiased • Independent • Data-Backed</span>
        </div>
        <h1>The Bluebook for<br/><em>Real Estate Agent Tools</em></h1>
        <p class="hero-sub">
          Just like Kelley Blue Book tells you what a car is actually worth —
          AgentBluebook tells you what agent software is actually worth.
          No vendor hype. No paid placements. Just honest reviews.
        </p>
        <div class="hero-actions">
          <a href="/best-picks" class="btn btn-primary btn-lg">See Best Picks →</a>
          <a href="/comparisons" class="btn btn-outline btn-lg" style="color:white;border-color:rgba(255,255,255,0.3);">Compare Tools</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item"><span class="trust-num">{reviewCount}</span><span class="trust-label">{reviewCount === 1 ? 'Review Published' : 'Reviews Published'}</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><span class="trust-num">$0</span><span class="trust-label">Paid Placements</span></div>
          <div class="trust-divider"></div>
          <div class="trust-item"><span class="trust-num">100%</span><span class="trust-label">Independent</span></div>
        </div>
      </div>
      <div class="hero-card-stack">
        {heroCards.map((card, i) => (
          <a href={card.href} class={`floating-card fc-${i + 1}`}>
            <div class="fc-label">{card.label}</div>
            <div class="fc-title">{card.title}</div>
            <div class="fc-score">{card.score}</div>
            <div class="fc-meta">{card.meta}</div>
          </a>
        ))}
        <div class={`floating-card fc-${heroCards.length + 1}`}>
          <div class="fc-label">OUR PROMISE</div>
          <div class="fc-title">No Paid Placements</div>
          <div class="fc-meta">Every score follows our published methodology — vendors can't buy a ranking.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── HOW WE RATE ── -->
<section class="how-we-rate section-sm">
  <div class="container">
    <div class="hwr-inner">
      <div class="hwr-text">
        <h2>How the Bluebook Score Works</h2>
        <p>Every review carries a single 1–10 score — an AI-generated holistic judgment built from researched facts: <strong>verified current pricing</strong>, <strong>real user feedback</strong>, and <strong>head-to-head competitor context</strong>. Affiliate commissions never touch the score. <a href="/methodology">Read exactly how it's produced →</a></p>
      </div>
      <div class="hwr-pillars">
        <div class="pillar">
          <div class="pillar-icon">💰</div>
          <div class="pillar-label">Verified Pricing</div>
        </div>
        <div class="pillar">
          <div class="pillar-icon">💬</div>
          <div class="pillar-label">Real User Feedback</div>
        </div>
        <div class="pillar">
          <div class="pillar-icon">⚖️</div>
          <div class="pillar-label">Competitor Context</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── FEATURED REVIEWS ── -->
<section class="featured section">
  <div class="container">
    <div class="section-header">
      <h2>Latest Reviews & Comparisons</h2>
      <a href="/reviews" class="btn btn-outline">View All →</a>
    </div>
    <div class="reviews-grid">
      {featured.map(article => <ArticleCard article={article} />)}
    </div>
  </div>
</section>

<!-- ── CATEGORIES ── -->
<section class="categories section" style="background: var(--off-white);">
  <div class="container">
    <div class="section-header">
      <h2>Browse by Category</h2>
      <p style="margin:0;font-size:0.9375rem;">Find reviews for every tool in an agent's tech stack</p>
    </div>
    <div class="cats-grid">
      {categories.map(cat => (
        <a href={cat.href} class="cat-card card">
          <div class="cat-icon">{cat.icon}</div>
          <div class="cat-info">
            <h4>{cat.label}</h4>
            <p>{cat.description}</p>
            <span class="cat-count">{cat.count}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ── TRUST STRIP ── -->
<section class="trust-strip section-sm">
  <div class="container">
    <div class="trust-strip-inner">
      <div class="ts-item">
        <div class="ts-icon">🔍</div>
        <div>
          <h4>We research current pricing</h4>
          <p>Every review pulls live pricing before publishing, and every price shows when it was verified.</p>
        </div>
      </div>
      <div class="ts-item">
        <div class="ts-icon">💬</div>
        <div>
          <h4>We read the real complaints</h4>
          <p>We scour Reddit, G2, and Capterra for what agents actually say.</p>
        </div>
      </div>
      <div class="ts-item">
        <div class="ts-icon">📊</div>
        <div>
          <h4>We give you a clear verdict</h4>
          <p>Every review ends with exactly who should buy it — and who should skip it.</p>
        </div>
      </div>
    </div>
  </div>
</section>

</Base>

<style>
/* ── Hero ── */
.hero {
  background: linear-gradient(135deg, var(--navy) 0%, #0f2540 60%, #162d4a 100%);
  padding: 80px 0 100px;
  position: relative; overflow: hidden;
}
.hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 60% 60% at 80% 50%, rgba(200,151,58,0.08) 0%, transparent 70%);
  pointer-events: none;
}
.hero-inner {
  display: grid; grid-template-columns: 1fr 380px; gap: 64px; align-items: center;
}
.hero-eyebrow { margin-bottom: 20px; }
.hero h1 { color: var(--white); margin-bottom: 20px; }
.hero h1 em { color: var(--gold); font-style: normal; }
.hero-sub { color: rgba(255,255,255,0.75); font-size: 1.125rem; line-height: 1.7; margin-bottom: 32px; max-width: 520px; }
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
.hero-trust { display: flex; align-items: center; gap: 24px; }
.trust-item { display: flex; flex-direction: column; }
.trust-num { font-family: var(--font-display); font-size: 1.8rem; font-weight: 800; color: var(--gold); line-height: 1; }
.trust-label { font-size: 0.75rem; color: rgba(255,255,255,0.5); margin-top: 2px; }
.trust-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.15); }

/* Floating cards */
.hero-card-stack { position: relative; height: 320px; }
.floating-card {
  position: absolute; background: var(--white); border-radius: var(--radius-lg);
  padding: 20px; box-shadow: var(--shadow-lg); width: 220px;
}
.fc-1 { top: 0; right: 0; z-index: 3; }
.fc-2 { top: 90px; right: 50px; z-index: 2; opacity: 0.92; transform: rotate(-2deg); }
.fc-3 { top: 180px; right: 90px; z-index: 1; opacity: 0.8; transform: rotate(-4deg); }
.fc-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; color: var(--gold); text-transform: uppercase; margin-bottom: 6px; }
.fc-title { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: var(--navy); margin-bottom: 8px; }
.fc-score {
  width: 44px; height: 44px; background: var(--navy); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-size: 1rem; font-weight: 800; color: var(--gold);
  margin-bottom: 8px;
}
.fc-3 .fc-score { background: #EF4444; color: white; }
.fc-meta { font-size: 0.75rem; color: var(--gray-600); }

/* How We Rate */
.how-we-rate { background: var(--gold-pale); border-top: 2px solid #E8D4A0; border-bottom: 2px solid #E8D4A0; }
.hwr-inner { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
.hwr-pillars { display: flex; gap: 12px; }
.pillar { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.pillar-icon { font-size: 1.5rem; }
.pillar-label { font-size: 0.7rem; font-weight: 600; color: var(--navy); text-align: center; white-space: nowrap; }

/* Section headers */
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 12px; }

/* Review cards */
.reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

/* Category grid */
.cats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.cat-card { display: flex; gap: 16px; padding: 20px; align-items: flex-start; }
.cat-card:hover { border-color: var(--gold); }
.cat-icon { font-size: 1.8rem; flex-shrink: 0; }
.cat-info h4 { margin-bottom: 4px; font-size: 1rem; }
.cat-info p { font-size: 0.875rem; color: var(--gray-600); margin: 0 0 8px; }
.cat-count { font-size: 0.75rem; color: var(--gold); font-weight: 600; }

/* Trust strip */
.trust-strip-inner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.ts-item { display: flex; gap: 16px; align-items: flex-start; }
.ts-icon { font-size: 1.5rem; flex-shrink: 0; }
.ts-item h4 { margin-bottom: 4px; font-size: 1rem; }
.ts-item p { font-size: 0.875rem; margin: 0; }

@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-card-stack { display: none; }
  .hwr-inner { grid-template-columns: 1fr; }
  .reviews-grid { grid-template-columns: 1fr 1fr; }
  .cats-grid { grid-template-columns: 1fr 1fr; }
  .trust-strip-inner { grid-template-columns: 1fr; gap: 24px; }
}
@media (max-width: 600px) {
  .reviews-grid { grid-template-columns: 1fr; }
  .cats-grid { grid-template-columns: 1fr; }
}
</style>
